# Copy this file to ".env" for local development. Never commit the real .env file.
# On Render, add these same names under Environment -> Environment Variables.

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/medbox

# Long random string used to sign login tokens (change it if it ever leaks)
JWT_SECRET=replace-with-a-long-random-string

PORT=5000

# Your Vercel site, so only it can call the API (comma-separate several)
CORS_ORIGIN=https://smart-ai-medicine-box.vercel.app

# Server timezone for dose times
TZ=Asia/Kolkata

# Missed-dose emails to the emergency contact (free Brevo account, see docs/EMAIL_SETUP.md)
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=MedBox

# Health assistant (free key from https://console.groq.com/keys)
GROQ_API_KEY=
# Optional: LLM_MODEL=llama-3.1-8b-instant
# Optional: LLM_BASE_URL=https://api.groq.com/openai/v1
